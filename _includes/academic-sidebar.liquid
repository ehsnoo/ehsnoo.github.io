<h1 class="academic-name">
  {{ site.first_name | escape }}
  {{ site.last_name | escape }}
</h1>
<figure class="academic-photo">
  <img
    class="profile-photo"
    src="{{ '/assets/img/ehs-noo.jpg' | relative_url }}"
    alt="Portrait of {{ site.first_name | escape }} {{ site.last_name | escape }}"
  >
</figure>
<p class="academic-position">PhD Student in Computer Science · University of Maryland, Baltimore County</p>
<nav class="contact-links" aria-label="Professional and contact links">
  <div class="contact-row">
    <a href="mailto:{{ site.data.socials.email | escape }}">Email</a>
    {% if site.data.profile.google_scholar -%}
      <a href="{{ site.data.profile.google_scholar | escape }}">Google Scholar</a>
    {%- endif %}
    {% if site.data.profile.cv_pdf -%}
      <a href="{{ site.data.profile.cv_pdf | prepend: '/' | relative_url }}">CV</a>
    {%- endif %}
  </div>
  <div class="contact-row">
    <a href="https://github.com/{{ site.data.socials.github_username | escape }}">GitHub</a>
    {% if site.data.profile.linkedin -%}
      <a href="{{ site.data.profile.linkedin | escape }}">LinkedIn</a>
    {%- endif %}
    {% if site.data.profile.orcid -%}
      <a href="{{ site.data.profile.orcid | escape }}">ORCID</a>
    {%- endif %}
  </div>
</nav>
{% if include.home_teaching %}
  <section class="teaching-sidebar" aria-labelledby="teaching-heading">
    <h2 id="teaching-heading">Teaching</h2>
    <p class="teaching-disclaimer">Example courses; not verified teaching appointments.</p>
    {% for course in site.data.teaching_examples %}
      <p class="teaching-course">{{ course.title | escape }} — {{ course.code | escape }}</p>
    {% endfor %}
    <p class="teaching-course">Office Hours: Monday/Tuesday, 8:00–9:00 AM</p>
  </section>
{% endif %}
